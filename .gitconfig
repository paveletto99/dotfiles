[user]
    name = Paolo Giovannini
    email = "paveletto99@gmail.com"
    signingkey = ~/.ssh/id_ed25519_github.pub

[gpg]
    format = ssh

[gpg "ssh"]
    allowedSignersFile = ~/.ssh/allowed_signers

[commit]
    gpgsign = true

[tag]
    gpgsign = true

[core]
    editor = "\"/Applications/Zed Preview.app/Contents/MacOS/cli\" --wait"
    excludesfile = ~/.gitignore
    fileMode = false
    pager = "pre=$(which delta); ${pre:-cat} | less --tabs=4 -RFX"

[merge]
    conflictStyle = zdiff3

[diff]
    colorMoved = default
    tool = zed

[difftool "zed"]
    cmd = \"/Applications/Zed Preview.app/Contents/MacOS/cli\" --wait $LOCAL $REMOTE

[log]
    decorate = true
    pretty = oneline

[credential]
    helper = osxkeychain

[alias]
    pf = push --force-with-lease
    pr = "!f() { git fetch origin pull/$1/head:$2; }; f"
    rebase-main = "!f() { git fetch origin main && git rebase origin/main; }; f"
