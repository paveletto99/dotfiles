[user]
  email = paveletto99@gmail.com
  name = pobo

[url "ssh://git@github.com/"]
  insteadOf = https://github.com/

[core]
  editor = nvim
  pager = delta
  excludesfile = ~/.gitignore
	fsmonitor = true
	untrackedCache = true
[merge]
#    tool = vscode
  conflictstyle = diff3
[branch]
  sort = -committerdate
[tag]
  sort = version:refname
[init]
  defaultBranch = main
[diff]
  algorithm = histogram
  colorMoved = plain
  mnemonicPrefix = true
  renames = true
[push]
  default = simple
  autoSetupRemote = true
  followTags = true
[fetch]
  prune = true
  pruneTags = true
  all = true
[column]
  ui = auto
[help]
  autocorrect = prompt
[commit]
  verbose = true
#    template = ~/.git_commit_msg
[rerere]
  enabled = true
  autoupdate = true
[rebase]
  autoSquash = true
  autoStash = true
  updateRefs = true
[pull]
	rebase = true
  ff = only
#[mergetool "vscode"]
#    cmd = code --wait $MERGED

#[difftool "vscode"]
#    cmd = code --wait --diff $LOCAL $REMOTE

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true    # use n and N to move between diff sections
    # delta detects terminal colors automatically; set one of these to disable auto-detection
    dark = true
    # light = true


# Comment: End of "Extra Block"
[color "grep"]
  linenumber = yellow bold
	match = red
	filename = magenta
[color "status"]
	added = green bold
	changed = yellow bold
	untracked = red bold
[color "branch"]
	current = yellow bold
	local = green bold
	remote = cyan bold
[credential]
	helper = cache
[gitflow "prefix"]
	feature = feature-
	release = release-
	hotfix = hotfix-
	support = support-
	versiontag = v
[web]
	browser = google-chrome
[alias]
	a = add .
	ai = add -i
	ac = commit --amend --no-edit
#############
	b = branch
	ba = branch -a
	bd = branch -d
	bdd = branch -D
	br = branch -r
	bc = rev-parse --abbrev-ref HEAD
	bu = !git rev-parse --abbrev-ref --symbolic-full-name "@{u}"
	bs = !git-branch-status
#############
	c = commit
	ca = commit -a
	cm = commit -m
	cam = commit -am
	cem = commit --allow-empty -m
	cd = commit --amend
	cad = commit -a --amend
	ced = commit --allow-empty --amend
#############
	d = diff
	dp = diff --patience
	dc = diff --cached
	dk = diff --check
	dck = diff --cached --check
	dt = difftool
	dct = difftool --cached
#############
	f = fetch
	fo = fetch origin
	fu = fetch upstream
#############
	ls = show --pretty=\"format:\" --name-only
############
	l = log --oneline
	lg = log --oneline --graph --decorate
#############
	o = checkout
	om = checkout master
	ob = checkout -b
#############
	m = merge
	mnf = merge --no-ff
	ma = merge --abort
	mc = merge --continue
	ms = merge --skip
#############
	ps = push
	psf = push -f
	psu = push -u
	pst = push --tags
#############
	pso = push origin
	psao = push --all origin
	psfo = push -f origin
	psuo = push -u origin
#############
	psom = push origin master
	psaom = push --all origin master
	psfom = push -f origin master
	psuom = push -u origin master
	psoc = !git push origin $(git bc)
	psaoc = !git push --all origin $(git bc)
	psfoc = !git push -f origin $(git bc)
	psuoc = !git push -u origin $(git bc)
	psdc = !git push origin :$(git bc)
#############
	pl = pull
	pb = pull --rebase
#############
	plo = pull origin
	pbo = pull --rebase origin
	plom = pull origin master
	ploc = !git pull origin $(git bc)
	pbom = pull --rebase origin master
	pboc = !git pull --rebase origin $(git bc)
#############
	r = remote
	ra = remote add
	rr = remote rm
	rv = remote -v
	rn = remote rename
	rp = remote prune
	rs = remote show
	rao = remote add origin
	rau = remote add upstream
	rro = remote remove origin
	rru = remote remove upstream
	rso = remote show origin
	rsu = remote show upstream
	rpo = remote prune origin
	rpu = remote prune upstream
#############
	s = status
	sb = status -s -b


