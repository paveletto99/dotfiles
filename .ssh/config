# GitHub profile recovered from the current Mac's ~/.ssh/config.
# This file is not deployed automatically: ~/.ssh/config also contains other hosts.
# Keep private keys local; this profile records only their expected filename.
Host github.com
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_ed25519_github
  IdentitiesOnly yes
  AddKeysToAgent yes
  IgnoreUnknown UseKeychain
  UseKeychain yes
