# Imported terminal appearance and behavior preferences.
Disabled alternatives; the active settings above remain authoritative.
theme = orng-dark
minimum-contrast = 1.1
font-size = 15
font-family = "TX-02"
window-padding-x = 5
window-padding-y = 0,10
window-width = 350
window-height = 472
font-thicken = true
window-padding-color = extend
window-save-state = always
scrollback-limit = 20000000
window-decoration = auto
macos-titlebar-style = native
macos-icon = chalkboard
clipboard-paste-protection = true
copy-on-select = true
clipboard-trim-trailing-spaces = true
mouse-hide-while-typing = true
mouse-shift-capture = never
cursor-style-blink = false
shell-integration-features = true
notify-on-command-finish = unfocused
notify-on-command-finish-action = no-bell,notify
notify-on-command-finish-after = 30s
link-url = true
link-previews = osc8
auto-update = download
quick-terminal-position = top
quick-terminal-screen = mouse
quick-terminal-animation-duration = 0.15
keybind = shift+down=jump_to_prompt:1
